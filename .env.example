# OAuth-токен Яндекс.Метрики (https://oauth.yandex.ru/)
YANDEX_METRIKA_TOKEN=your_oauth_token_here

# ID счётчика Метрики
YANDEX_METRIKA_COUNTER_ID=12345678

# Ключ Anthropic API — нужен для генерации аналитического текста
ANTHROPIC_API_KEY=sk-ant-...

# Необязательно: модель для написания текста (по умолчанию claude-opus-5)
REPORT_MODEL=claude-opus-5

# Необязательно: усилие модели — low/medium/high (по умолчанию low, быстрее)
REPORT_EFFORT=low

# Необязательно: точность выборки Метрики — medium/high/full (по умолчанию medium).
# full точнее, но над периодом в сезон считается очень долго.
METRIKA_ACCURACY=medium

# Необязательно: таймаут одного запроса к Метрике, сек (по умолчанию 50)
METRIKA_TIMEOUT=50
